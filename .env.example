# Public storefront URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://verdant.com

# Hosted checkout the cart hands off to. The cart id is appended as ?cart=<id>.
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.verdant.com/c

# Customer portal where subscribers skip, swap or pause deliveries.
NEXT_PUBLIC_ACCOUNT_URL=https://account.verdant.com

# Optional ESP webhook for "first dibs on new flavors" sign-ups.
NEWSLETTER_WEBHOOK_URL=
